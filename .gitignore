# The cartridge is the user's own and is never committed.
roms/
*.nes
*.unif
*.unl

# Generated from the submodule's binary PDS containers by tools/pds_extract.py
pds-text/

# Assembler / build output
asm/out/
*.lst
*.sym
*.bin

# Rust
/target
**/*.rs.bk

# Captured reference frames and scratch
shots/
out/

# Python
__pycache__/
*.pyc

# BizHawk capture output: screenshots contain cartridge-derived imagery and the
# memory dumps are large and reproducible. Never committed.
tools/bizhawk/out/

# Play-harness output: every BizHawk session log, the recorded input logs, and
# the checkpoints. The checkpoints hold framebuffer PNGs and full dumps of all
# nine memory domains, which is cartridge-derived imagery and cartridge-derived
# data -- exactly what `shots/` and `tools/bizhawk/out/` are already excluded for.
# The input logs are plain button sequences, but they are large and they are
# evidence for a particular run, so they stay out of history too.
logs/
