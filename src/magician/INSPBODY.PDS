;   What a cast of Inspect draws, once the latch is set.
;
;   The bytes live in the $FF run that follows X2's `mptrh` table. mptrh is
;   16 high-bytes and the next byte in slot 1 is $FF through the end of the
;   bank (PRG $392D, 1746 bytes). farjsr67 with Y=1 maps slot 1 at $A000, so
;   this org is where that call lands. The routine only calls the fixed
;   window ($C000/$E000), so the bank in the $8000 window does not matter.
;
;   Who gets a mark, measured off the same bytes obaggro reads:
;
;     * skip the player (slot 3) and anything whose obtyp bit 7 is set
;     * skip an object whose 16-bit position is not on this screen. The
;       screen origin is mapx/mapy, and the low byte of (position - origin)
;       is the sprite coordinate addspr wants
;     * obchr bits 3-2 are the interact control (x0.pds `c` macro). 0 means
;       "always no one there" (x4.pds). Those get nothing
;     * obaggro = 0 with a control set is friendly. obaggro = 1 is the
;       attack control with the count run out
;
;   The glow is his own sprites, not a block drawn above him. The monk's
;   standing frame is ten tiles, $74-$7D, a 16x40 of two columns and five
;   rows (slot 5 frame header $A372: x offsets $F8/$00, y offsets
;   $EC/$F4/$FC/$04/$0C). frame (slot 2 $9759) plants those at
;   (obxl-mapx, obyl-mapy) before this hook runs, and facing right
;   subtracts another 8 from the x origin first, so the columns sit at
;   x-16 and x-8. A bright frame ORs attribute $03 onto those sprites
;   and leaves the flip bits. Tile $B2 is not drawn for the glow.
;
;   Gameplay loads spal00, which is spr.pal, through movepal with X=$1F:
;
;     pal 0 ($3F10)  $0F $0F $27 $37   the player ($27 is his tunic)
;     pal 1 ($3F14)  $0F $0F $26 $36   his robe. Attribute $01 is this
;     pal 2 ($3F18)  $0F $0F $10 $30   the white bar. Not written here
;     pal 3 ($3F1C)  $0F $0F $2A $3A   the pulse. Friendly stays green
;
;   Measured on this machine's QuickNES palette (block 7): $36 is
;   (214,159,152) and $26 is (224,90,72), so attribute $01 does not
;   change the robe. $16 is (150,18,1) and $06 is (82,0,0). Both pulses
;   share attribute $03. A hostile bright frame queues $06/$16 into
;   cursprpal palette 3, which nmi0 copies at vblank; a friendly frame
;   leaves the green. Nothing here writes $2006/$2007. The dim half, a
;   friendly frame, and a cleared red flag copy those two bytes back
;   from orgsprpal. Palette 0 and palette 2 are not touched, so the
;   player and the white bar stay. Sprites whose tile is outside
;   $74-$7D are not recolored, which is what keeps the player. Title
;   entry runs initcols, which clears cursprpal, so a red left over
;   when the latch drops does not survive the title.
;
;   inspph ($0745) counts 1..60: 1..30 recolors the body, 31..60 does
;   not, and the sprite list was rebuilt this frame in his own colours.
;   $FF starts the count at 1. The latch stays set. insppal ($0747) is
;   $5A while the red is queued.
;
;   insppow (written by obinspect from firespell's t2, which is 1..4):
;
;     * 1: the body recolor only. A zero obhbar draws no bar, and the
;       recolor stays
;     * 2: the glow, then obhbar copies of tile $B2 when that count is
;       not zero, then one tile $D8 when obven is not zero. That is the
;       harm path's own test (x4.pds, lda obven,x / beq), not a 0-20 scale
;     * 3: also one tile $B2 for each of obphysh/obvensh/obfirsh/obpowsh
;       that is not zero. Those four counters are write-only, so the pip
;       is the stored byte, not a hit count
;     * 4: also one tile from obweak. $C8 ethereal, $D8 explode-only,
;       $D0 neither, $DE the damage path
;
;   addspr overwrites Y. The segment count is saved around the call.
;   A column at X+8 that would pass $FF is not drawn. The bar stops on
;   that same carry, so a row anchored at $F8 does not continue at $00.
;   A level-3 pip is eight pixels right of the previous one, and the
;   add that would pass $FF is not stored either.
;
;   The picture shows eight sprites on one scanline. A bar is obhbar
;   tiles on one y, so two full bars are fourteen sprites and the
;   second would be clipped down to a single tile. The bar is drawn
;   only when every segment fits among the sprites already on that y.
;   inspalt ($0746) flips which object is visited first, so the bar
;   that did not fit is the complete one on the next frame.
;
;   IN:  none. Called by farjsr67, so rts returns to it.
;   OUT: marked bodies recolored; bars and pips added for powers 2..4
;   USES: A, X, Y, t0..t7
;
;   Written by us. Eurocom's source is read-only and pinned; see README.md.

bar_tile   equ $b2
mark_attr  equ $02
grn_attr   equ $03
mark_above equ $18
body_lo    equ $74
body_hi    equ $7e
ven_tile   equ $d8
tile_eth   equ $c8
tile_exp   equ $d8
tile_none  equ $d0
tile_dmg   equ $de
insppow    equ $0744
insppal    equ $0747
red_lo     equ $06
red_hi     equ $16

        org $b92d
inspbody
        inc inspalt
        jsr ib_tick
        jsr ib_unred
        lda inspalt
        and #1
        beq ib_st
        ldx #pi
        dex
        jmp ib_lp
ib_st   ldx #0
ib_lp   cpx #pi
        beq ib_nx
        lda obtyp,x
        bmi ib_nx
        sec
        lda obxl,x
        sbc mapx
        sta t0
        lda obxh,x
        sbc mapx+1
        bne ib_nx
        sec
        lda obyl,x
        sbc mapy
        sta t1
        lda obyh,x
        sbc mapy+1
        bne ib_nx
        lda obchr,x
        and #$0c
        beq ib_nx
        jsr ib_mark
ib_nx   lda inspalt
        and #1
        beq ib_up
        dex
        cpx #$ff
        bne ib_lp
        rts
ib_up   inx
        cpx #4
        bne ib_lp
        rts

ib_mark jsr obaggro
        php
        lda t0
        sta t4
        lda t1
        sta t7
        lda inspph
        cmp #31
        bcs ib_dim
        plp
        beq ib_hue
        jsr ib_red
ib_hue  jsr ib_tint
        jmp ib_lv
ib_dim  plp
ib_lv   lda insppow
        cmp #2
        bcc ib_ret
        lda t7
        sec
        sbc #mark_above
        bcc ib_ex
        sta t5
        sta t1
        lda t4
        sta t0
        lda #mark_attr
        sta t3
        lda #bar_tile
        sta t2
        jsr obhbar
        beq ib_ex
        sta t6
        jsr ib_room
        bcs ib_ex
        ldy t6
ib_seg  tya
        pha
        jsr addspr
        pla
        tay
        lda t0
        clc
        adc #8
        bcs ib_ex
        sta t0
        dey
        bne ib_seg
ib_ex   jsr ib_more
ib_ret  rts

ib_more lda insppow
        cmp #2
        bcs im_v
        jmp im_out
im_v    lda obven,x
        beq im_lv3
        lda t5
        clc
        adc #8
        bcs im_lv3
        sta t1
        lda t4
        sta t0
        lda #ven_tile
        sta t2
        lda #mark_attr
        sta t3
        jsr addspr
im_lv3  lda insppow
        cmp #3
        bcs im_s
        jmp im_out
im_s    lda #0
        sta t6
im_sl   lda t6
        asl
        asl
        sta t7
        txa
        clc
        adc t7
        tay
        lda obphysh,y
        beq im_sn
        lda t5
        sec
        sbc #8
        bcc im_sn
        sta t1
        lda t6
        asl
        asl
        asl
        clc
        adc t4
        bcs im_sn
        sta t0
        lda #bar_tile
        sta t2
        lda #mark_attr
        sta t3
        jsr addspr
im_sn   inc t6
        lda t6
        cmp #4
        bne im_sl
        lda insppow
        cmp #4
        bcs im_w
        jmp im_out
im_w    jsr obweak
        cmp #$80
        bne im_e1
        lda #tile_eth
        bne im_put
im_e1   cmp #$01
        bne im_e2
        lda #tile_exp
        bne im_put
im_e2   cmp #$02
        bne im_e3
        lda #tile_none
        bne im_put
im_e3   lda #tile_dmg
im_put  sta t2
        lda t5
        sec
        sbc #16
        bcc im_out
        sta t1
        lda t4
        sta t0
        lda #mark_attr
        sta t3
        jsr addspr
im_out  rts

; OR attribute $03 onto this object's standing sprites. X survives.
; t4 is the screen x, t7 the screen y. Columns are x-16, x-8 and x
; (the two the frame uses, plus the facing-right shift). Rows are
; y-20, y-12, y-4, y+4 and y+12. Flip bits stay. Any other tile,
; including the player and tile $B2, is left where the game put it.
ib_tint ldy #0
it_n    cpy sprind
        beq it_out
        tya
        pha
        asl
        asl
        tay
        lda spr+1,y
        cmp #body_lo
        bcc it_sk
        cmp #body_hi
        bcs it_sk
        lda spr+3,y
        sec
        sbc t4
        cmp #$f0
        beq it_yy
        cmp #$f8
        beq it_yy
        cmp #$00
        bne it_sk
it_yy   lda spr,y
        sec
        sbc t7
        cmp #$ec
        beq it_ok
        cmp #$f4
        beq it_ok
        cmp #$fc
        beq it_ok
        cmp #$04
        beq it_ok
        cmp #$0c
        bne it_sk
it_ok   lda spr+2,y
        ora #grn_attr
        sta spr+2,y
it_sk   pla
        tay
        iny
        bne it_n
it_out  rts

; SEC when t6 more sprites would make nine or more on y = t1.
; X survives. t7 is free: the anchor y is already in t5.
ib_room ldy #0
        lda #0
        sta t7
ib_rc   cpy sprind
        beq ib_rd
        tya
        pha
        asl
        asl
        tay
        lda spr,y
        cmp t1
        bne ib_rn
        inc t7
ib_rn   pla
        tay
        iny
        bne ib_rc
ib_rd   lda t7
        clc
        adc t6
        cmp #9
        rts

; 1..30 bright, 31..60 dim. $FF and 60 both land on 1.
ib_tick lda inspph
        cmp #60
        bcc ib_ti
        lda #$00
ib_ti   clc
        adc #$01
        sta inspph
        rts

; Drop the queued red. orgsprpal still holds spr.pal.
ib_unred lda insppal
        cmp #$5a
        bne iu_out
        lda orgsprpal+$0e
        sta cursprpal+$0e
        lda orgsprpal+$0f
        sta cursprpal+$0f
        lda #$00
        sta insppal
iu_out  rts

; Palette 3, index 2 and 3. nmi0 copies cursprpal on the next vblank.
ib_red  lda #red_lo
        sta cursprpal+$0e
        lda #red_hi
        sta cursprpal+$0f
        lda #$5a
        sta insppal
        rts
