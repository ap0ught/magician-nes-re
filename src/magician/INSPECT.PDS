;   Inspect — the cast entry for spell slot 27 (issue #3).
;
;   The slot's init used to be the one-byte `rts` at $9112. The next byte,
;   $9113, is `pha` and is called by other spells, so that rts stays. SPSLOT
;   points the init vector here instead. The call is `jmp (t0)` from
;   castspell's bulreq==0 path (x2.pds), so `rts` returns to firespell, which
;   then spends the mana.
;
;   A cast does not draw. The sprite list is rebuilt every frame and wiped
;   back to $F8 from `sprind` (x5.pds, the `lda #$f8` after `dobuls`), so a
;   sprite written only inside the cast is gone on the next frame. The cast
;   sets `insplatch` and returns. INSPHOOK calls `inspdraw` in place of
;   `jsr tickmana`, after that wipe, and `inspdraw` asks INSPBODY to mark
;   whoever is on screen. The latch stays set, so the mark follows the
;   object: friendly on one frame, the bar on the next, once an interact
;   has dropped his count to 0.
;
;   `insplatch` is the first byte of the slack under x0.pds's
;   `if z>$0756`. `z` is $0743 and nothing in the source names $0743-$0756.
;   BizHawk's RAM comes up $FF there and the game never writes it, so the
;   "showing" value is $5A rather than any non-zero. $00 and $FF both mean off.
;   The next byte, `insppow`, is the power firespell left in t2: `iny` makes
;   it 1..4. The drawer reads it every frame.
;
;   IN:  as the spell init (jmp indirect). t2 = power 1..4.
;   OUT: A = t2, X and Y preserved, insplatch = $5A, insppow = t2
;   USES: A
;
;   Written by us. Eurocom's source is read-only and pinned; see README.md.

insplatch equ $0743
insppow   equ $0744

        org $fb47
obinspect
        lda #$5a
        sta insplatch
        lda t2
        sta insppow
        rts

inspdraw
        jsr tickmana
        lda insplatch
        cmp #$5a
        bne insp_out
        lda #>inspbody
        ldx #<inspbody
        stx ma
        ldx #0
        stx ma+2
        ldy #1
        sty ma+3
        jsr farjsr67
insp_out
        rts
